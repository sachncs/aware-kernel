---
import Logo from "./Logo.astro";
import { withBase } from "../lib/base";

const links = [
  { href: "#features", label: "Features" },
  { href: "#architecture", label: "Architecture" },
  { href: "#benchmarks", label: "Benchmarks" },
  { href: "#api", label: "API" },
];

const github = "https://github.com/sachncs/kernos";
const pypi = "https://pypi.org/project/kernos/";
const homeHref = withBase("/");
---

<header
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  id="site-nav"
>
  <div class="container-page">
    <div
      class="mt-3 flex items-center justify-between rounded-2xl border border-white/5 bg-ink-950/60 px-4 py-2.5 backdrop-blur-xl transition-all sm:px-5"
      id="nav-inner"
    >
      <a
        href={homeHref}
        class="group flex items-center gap-2.5 text-sm font-medium text-ink-50"
      >
        <Logo class="h-7 w-7" />
        <span class="font-display text-[15px] font-semibold tracking-tight">
          kernos
        </span>
      </a>

      <nav class="hidden items-center gap-1 md:flex">
        {
          links.map((l) => (
            <a
              href={l.href}
              class="rounded-full px-3 py-1.5 text-[13px] text-ink-300 transition hover:bg-white/5 hover:text-white"
            >
              {l.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-2">
        <a
          href={github}
          aria-label="GitHub repository"
          class="btn-icon hidden sm:inline-flex"
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
            <path
              d="M12 .5C5.7.5.7 5.5.7 11.8c0 5 3.3 9.2 7.8 10.7.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.8-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.4-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2.9-.3 2-.4 3-.0 1-.3 2-.0 3 0 2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.9 1.2 3.1 0 4.5-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.2c0 .3.2.7.8.6 4.5-1.5 7.8-5.7 7.8-10.7C23.3 5.5 18.3.5 12 .5z"
            />
          </svg>
        </a>
        <a href="#install" class="btn-primary !px-4 !py-2 text-[13px]">
          Get started
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const nav = document.getElementById("site-nav");
  const inner = document.getElementById("nav-inner");
  function onScroll() {
    if (!nav || !inner) return;
    const scrolled = window.scrollY > 8;
    inner.classList.toggle("mt-3", !scrolled);
    inner.classList.toggle("mt-2", scrolled);
    inner.classList.toggle("border-white/10", scrolled);
  }
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>