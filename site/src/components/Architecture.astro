---
const params = [
  {
    label: "Continuous θ, R",
    where: "every step",
    what: "Updated via gradient descent on the validation loss.",
    color: "accent",
  },
  {
    label: "Discrete Z, A, M_g, c_g, c_l, ρ",
    where: "on drift",
    what: "Refreshed only when basis drift exceeds a learned threshold.",
    color: "blue",
  },
];

const stages = [
  {
    name: "Embed",
    body: "Project input space into a continuous embedding.",
    math: "Φ",
  },
  {
    name: "Basis",
    body: "Global Nyström landmarks via k-means++ and spectral whitening.",
    math: "Z, M_g",
  },
  {
    name: "Correct",
    body: "Residual-aware anchors + orthogonalized local features.",
    math: "A, M_l",
  },
  {
    name: "Fuse",
    body: "Trace-based calibration + logistic gate across global and local.",
    math: "c_g, c_l, ρ",
  },
  {
    name: "Solve",
    body: "Direct, iterative, or Jacobi ridge solve on ΦᵀΦ + λI.",
    math: "w",
  },
];
---

<section id="architecture" class="relative py-28 sm:py-36">
  <div class="container-page">
    <div class="mx-auto max-w-3xl text-center">
      <span class="chip reveal">
        <span class="chip-dot"></span>
        Architecture
      </span>
      <h2
        class="reveal mt-5 font-display text-3xl font-semibold tracking-tight gradient-text sm:text-5xl"
      >
        Two parameter groups, one disciplined loop.
      </h2>
      <p
        class="reveal mx-auto mt-5 max-w-2xl text-balance text-base leading-relaxed text-ink-300"
      >
        Kernos splits every parameter into a continuously-learned group and a
        discretely-refreshed group. The expensive refresh fires only when the
        basis drifts past a threshold you control.
      </p>
    </div>

    <div class="reveal mt-14 overflow-hidden rounded-3xl border border-white/[0.06] bg-gradient-to-b from-white/[0.025] to-transparent">
      <div class="grid gap-0 lg:grid-cols-[1.1fr_1fr]">
        <div class="p-6 sm:p-10">
          <div class="text-[11px] uppercase tracking-[0.18em] text-ink-500">
            The hybrid loop
          </div>
          <h3 class="mt-3 font-display text-xl font-semibold tracking-tight text-ink-50">
            Continuous descent. Discrete refresh.
          </h3>
          <p class="mt-4 text-[14px] leading-relaxed text-ink-300">
            Each step, the continuous parameters learn by gradient descent.
            Periodically, a drift-aware controller decides whether to refresh
            the discrete basis — gated by cooldown, warmup, hysteresis, and an
            amortized refresh budget.
          </p>

          <div class="mt-8 space-y-4">
            {
              params.map((p) => (
                <div class="flex items-start gap-4 rounded-2xl border border-white/[0.06] bg-white/[0.02] p-4">
                  <div
                    class={`mt-0.5 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border text-[11px] font-mono ${
                      p.color === "accent"
                        ? "border-accent-500/30 bg-accent-500/10 text-accent-200"
                        : "border-blue-500/30 bg-blue-500/10 text-blue-200"
                    }`}
                  >
                    {p.color === "accent" ? "∂" : "Δ"}
                  </div>
                  <div>
                    <div class="flex items-center gap-2">
                      <span class="font-mono text-[13px] text-ink-100">
                        {p.label}
                      </span>
                      <span class="rounded-full bg-white/[0.05] px-2 py-0.5 text-[10px] uppercase tracking-wider text-ink-300">
                        {p.where}
                      </span>
                    </div>
                    <p class="mt-1 text-[13px] leading-relaxed text-ink-300">
                      {p.what}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>

          <div class="mt-8 grid grid-cols-2 gap-3 text-[12px] text-ink-300 sm:grid-cols-4">
            <div class="rounded-xl border border-white/[0.06] bg-white/[0.02] px-3 py-2.5">
              <div class="text-ink-500">Drift</div>
              <div class="mt-1 font-mono text-ink-100">frobenius · spectral</div>
            </div>
            <div class="rounded-xl border border-white/[0.06] bg-white/[0.02] px-3 py-2.5">
              <div class="text-ink-500">Trigger</div>
              <div class="mt-1 font-mono text-ink-100">d_t &gt; drift_hi</div>
            </div>
            <div class="rounded-xl border border-white/[0.06] bg-white/[0.02] px-3 py-2.5">
              <div class="text-ink-500">Cooldown</div>
              <div class="mt-1 font-mono text-ink-100">cool = 50</div>
            </div>
            <div class="rounded-xl border border-white/[0.06] bg-white/[0.02] px-3 py-2.5">
              <div class="text-ink-500">Budget</div>
              <div class="mt-1 font-mono text-ink-100">amortized</div>
            </div>
          </div>
        </div>

        <div class="relative border-t border-white/[0.06] bg-gradient-to-b from-white/[0.04] to-transparent p-6 sm:p-10 lg:border-l lg:border-t-0">
          <div class="text-[11px] uppercase tracking-[0.18em] text-ink-500">
            Pipeline
          </div>
          <h3 class="mt-3 font-display text-xl font-semibold tracking-tight text-ink-50">
            Five stages. One coherent model.
          </h3>

          <ol class="relative mt-6 space-y-3">
            <span
              class="absolute left-[19px] top-2 bottom-2 w-px bg-gradient-to-b from-accent-500/40 via-white/10 to-blue-500/40"
              aria-hidden="true"
            ></span>
            {
              stages.map((s, i) => (
                <li class="relative flex items-start gap-4">
                  <span class="relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/10 bg-ink-950 font-mono text-[12px] text-ink-200">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <div class="rounded-xl border border-white/[0.05] bg-white/[0.015] px-4 py-3">
                    <div class="flex items-center gap-2">
                      <span class="font-display text-[14px] font-semibold text-ink-50">
                        {s.name}
                      </span>
                      <span class="rounded-full bg-white/[0.05] px-2 py-0.5 font-mono text-[10px] text-ink-300">
                        {s.math}
                      </span>
                    </div>
                    <p class="mt-1 text-[13px] leading-relaxed text-ink-300">
                      {s.body}
                    </p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>

    <div class="reveal mt-12 grid gap-4 sm:grid-cols-3">
      <div class="rounded-2xl border border-white/[0.06] bg-white/[0.02] p-6">
        <div class="font-mono text-[12px] text-ink-500">rank(K) ≤</div>
        <div class="mt-2 font-display text-2xl font-semibold tracking-tight text-ink-50">
          r_g + m_l
        </div>
        <p class="mt-2 text-[13px] text-ink-300">
          Explicit rank bound: global Nyström landmarks plus local corrective
          rank.
        </p>
      </div>
      <div class="rounded-2xl border border-white/[0.06] bg-white/[0.02] p-6">
        <div class="font-mono text-[12px] text-ink-500">kernel PSD</div>
        <div class="mt-2 font-display text-2xl font-semibold tracking-tight text-ink-50">
          K = ΦΦᵀ
        </div>
        <p class="mt-2 text-[13px] text-ink-300">
          Constructed as a product of explicit features. Positive
          semidefinite by construction.
        </p>
      </div>
      <div class="rounded-2xl border border-white/[0.06] bg-white/[0.02] p-6">
        <div class="font-mono text-[12px] text-ink-500">orthogonality</div>
        <div class="mt-2 font-display text-2xl font-semibold tracking-tight text-ink-50">
          Φ_gᵀ Φ_l ≈ 0
        </div>
        <p class="mt-2 text-[13px] text-ink-300">
          Local features live in the global nullspace, kept stable by ridge
          regularization.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.05, rootMargin: "0px 0px -10% 0px" }
  );
  document.querySelectorAll("#architecture .reveal").forEach((el) => observer.observe(el));
</script>