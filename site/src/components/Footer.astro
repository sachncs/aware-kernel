---
import Logo from "./Logo.astro";
import { withBase } from "../lib/base";

const groups = [
  {
    title: "Product",
    links: [
      { href: "#features", label: "Features" },
      { href: "#architecture", label: "Architecture" },
      { href: "#benchmarks", label: "Benchmarks" },
      { href: "#api", label: "API" },
      { href: "#install", label: "Install" },
    ],
  },
  {
    title: "Docs",
    links: [
      { href: "https://github.com/sachncs/kernos/blob/master/docs/getting-started.md", label: "Getting started" },
      { href: "https://github.com/sachncs/kernos/blob/master/docs/design.md", label: "Design" },
      { href: "https://github.com/sachncs/kernos/blob/master/docs/architecture.md", label: "Architecture" },
      { href: "https://github.com/sachncs/kernos/blob/master/docs/evaluation-protocol.md", label: "Evaluation protocol" },
      { href: "https://github.com/sachncs/kernos/blob/master/docs/faq.md", label: "FAQ" },
    ],
  },
  {
    title: "Resources",
    links: [
      { href: "https://github.com/sachncs/kernos", label: "Source" },
      { href: "https://github.com/sachncs/kernos/releases", label: "Releases" },
      { href: "https://github.com/sachncs/kernos/blob/master/CHANGELOG.md", label: "Changelog" },
      { href: "https://pypi.org/project/kernos/", label: "PyPI" },
      { href: "https://github.com/sachncs/kernos/blob/master/CONTRIBUTING.md", label: "Contributing" },
    ],
  },
];

const social = [
  {
    label: "GitHub",
    href: "https://github.com/sachncs/kernos",
    icon: "github",
  },
  {
    label: "PyPI",
    href: "https://pypi.org/project/kernos/",
    icon: "pypi",
  },
  {
    label: "RSS",
    href: "https://github.com/sachncs/kernos/releases.atom",
    icon: "rss",
  },
];
---

<footer class="relative mt-10 border-t border-white/[0.06]">
  <div class="container-page py-16">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_2fr]">
      <div>
        <a href={withBase("/")} class="flex items-center gap-2.5">
          <Logo class="h-7 w-7" />
          <span class="font-display text-[15px] font-semibold tracking-tight">kernos</span>
        </a>
        <p class="mt-4 max-w-sm text-[13.5px] leading-relaxed text-ink-400">
          Refresh-aware hybrid kernel learning for scalable, adaptive regression. Open source under MIT.
        </p>

        <div class="mt-6 flex items-center gap-2">
          {
            social.map((s) => (
              <a
                href={s.href}
                aria-label={s.label}
                class="btn-icon"
              >
                {s.icon === "github" && (
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.7.5.7 5.5.7 11.8c0 5 3.3 9.2 7.8 10.7.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.8-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.4-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2.9-.3 2-.4 3-.0 1-.3 2-.0 3 0 2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.9 1.2 3.1 0 4.5-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.2c0 .3.2.7.8.6 4.5-1.5 7.8-5.7 7.8-10.7C23.3 5.5 18.3.5 12 .5z"/></svg>
                )}
                {s.icon === "pypi" && (
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
                    <path d="M2 4.5C2 3.1 3.1 2 4.5 2h15C20.9 2 22 3.1 22 4.5v15c0 1.4-1.1 2.5-2.5 2.5h-15C3.1 22 2 20.9 2 19.5v-15zM5 6v12h2v-5h3v5h2V6H5zm10 0v12h4v-2h-2V6h-2z"/>
                  </svg>
                )}
                {s.icon === "rss" && (
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
                    <path d="M5 3a16 16 0 0 1 16 16h-3A13 13 0 0 0 5 6V3zm0 7a9 9 0 0 1 9 9h-3a6 6 0 0 0-6-6v-3zm1.5 7.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5z"/>
                  </svg>
                )}
              </a>
            ))
          }
        </div>
      </div>

      <div class="grid gap-10 sm:grid-cols-3">
        {
          groups.map((g) => (
            <div>
              <div class="text-[11px] uppercase tracking-[0.18em] text-ink-500">
                {g.title}
              </div>
              <ul class="mt-4 space-y-2.5">
                {g.links.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      class="text-[13.5px] text-ink-300 transition hover:text-white"
                    >
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-14 flex flex-col items-start justify-between gap-3 border-t border-white/[0.06] pt-6 text-[12px] text-ink-500 sm:flex-row sm:items-center">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <span>© 2026 Sachin.</span>
        <span>·</span>
        <a href="LICENSE" class="hover:text-white">MIT license</a>
        <span>·</span>
        <a href="https://github.com/sachncs/kernos/blob/master/SECURITY.md" class="hover:text-white">Security</a>
        <span>·</span>
        <a href="https://github.com/sachncs/kernos/blob/master/CODE_OF_CONDUCT.md" class="hover:text-white">Code of conduct</a>
      </div>
      <div class="font-mono">
        kernos · v0.2.0 · built with Astro
      </div>
    </div>
  </div>
</footer>